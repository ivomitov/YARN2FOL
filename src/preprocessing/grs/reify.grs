rule domain_to_be01 {
    pattern {
        X [type="V"];
        Y [type="V"];
        Z [type="H"];
        DOMAIN [type="E", rel="domain"];
        e1: X->DOMAIN;
        e2: DOMAIN->Y;
        e3: Z->DOMAIN
    }
    commands {
        DOMAIN.type = "V";
        DOMAIN.pred = "be-01";
        DOMAIN.var = "";
        del_feat DOMAIN.rel;
        add_node ARG2;
        ARG2.type = "E";
        ARG2.rel = "ARG2";
        add_node ARG1;
        ARG1.type = "E";
        ARG1.rel = "ARG1";
        add_edge e4: DOMAIN->ARG2;
        add_edge e5: ARG2->X;
        add_edge e6: DOMAIN->ARG1;
        add_edge e7: ARG1->Y;
        del_edge e1;
        del_edge e2;
    }
}

rule mod_to_be01 {
    pattern {
        X [type="V"];
        Y [type="V"];
        Z [type="H"];
        MOD [type="E", rel="mod"];
        e1: X->MOD;
        e2: MOD->Y;
        e3: Z->MOD
    }
    commands {
        MOD.type = "V";
        MOD.pred = "be-01";
        MOD.var = "";
        del_feat MOD.rel;
        add_node ARG2;
        ARG2.type = "E";
        ARG2.rel = "ARG2";
        add_node ARG1;
        ARG1.type = "E";
        ARG1.rel = "ARG1";
        add_edge e4: MOD->ARG2;
        add_edge e5: ARG2->Y;
        add_edge e6: MOD->ARG1;
        add_edge e7: ARG1->X;
        del_edge e1;
        del_edge e2;
    }
}

rule poss_to_have03 {
    pattern {
        X [type="V"];
        Y [type="V"];
        Z [type="H"];
        POSS [type="E", rel="poss"];
        e1: X->POSS;
        e2: POSS->Y;
        e3: Z->POSS
    }
    commands {
        POSS.type = "V";
        POSS.pred = "have-03";
        POSS.var = "";
        del_feat POSS.rel;
        add_node ARG0;
        ARG0.type = "E";
        ARG0.rel = "ARG0";
        add_node ARG1;
        ARG1.type = "E";
        ARG1.rel = "ARG1";
        add_edge e4: POSS->ARG0;
        add_edge e5: ARG0->Y;
        add_edge e6: POSS->ARG1;
        add_edge e7: ARG1->X;
        del_edge e1;
        del_edge e2;
    }
}

