rule domain_to_be01 {
    pattern {
        X [type="V"];
        Y [type="V"];
        Z [type="H"];
        DOMAIN [type="E", rel="domain"];
        e1: X->DOMAIN;
        e2: DOMAIN->Y;
        e3: Z->DOMAIN
    }
    commands {
        DOMAIN.type = "V";
        DOMAIN.pred = "be-01";
        DOMAIN.var = "";
        del_feat DOMAIN.rel;
        add_edge e4: DOMAIN->X;
        e4.label = "ARG2";
        add_edge e5: DOMAIN->Y;
        e5.label = "ARG1";
        del_edge e1;
        del_edge e2;
    }
}

